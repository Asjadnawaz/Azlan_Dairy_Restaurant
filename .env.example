# Copy to .env and fill in. Everything except the two NEXT_PUBLIC_* values is
# server-only and must never reach the browser.

# Supabase project (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin account emails (server-side check)
ADMIN_EMAILS=
# Same list, exposed to the client for UI gating only — never a security check
NEXT_PUBLIC_ADMIN_EMAILS=

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Canonical site URL used for metadata, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://azlanfastfood.com
