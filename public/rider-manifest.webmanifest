{
  "id": "azlan-rider-app",
  "name": "Azlan Rider Portal",
  "short_name": "Azlan Rider",
  "description": "Dedicated delivery dispatch, order tracking, and shift management portal for Azlan Fast Food delivery partners in Malir, Karachi.",
  "start_url": "/rider",
  "scope": "/rider",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0b0f19",
  "theme_color": "#07110B",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icons/rider-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/rider-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/rider-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Active Deliveries",
      "short_name": "Delivery",
      "description": "View assigned orders ready for delivery",
      "url": "/rider",
      "icons": [{ "src": "/icons/rider-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Shift Summary",
      "short_name": "Aaj Ka Kaam",
      "description": "View delivered orders and earned cash on delivery",
      "url": "/rider",
      "icons": [{ "src": "/icons/rider-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Rider Profile",
      "short_name": "Profile",
      "description": "Update vehicle and rider profile",
      "url": "/rider/profile",
      "icons": [{ "src": "/icons/rider-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
